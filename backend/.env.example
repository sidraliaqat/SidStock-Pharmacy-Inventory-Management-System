# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharmacy_inventory
DB_SSL=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=1d

# CORS
CLIENT_URL=http://localhost:5173

# Uploads
MAX_UPLOAD_SIZE_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# Seed admin account (development only)
SEED_ADMIN_EMAIL=SidStock.admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@12345
